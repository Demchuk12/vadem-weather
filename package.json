{
  "name": "vadem-weather",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Weather app on Vue 3 + TypeScript + Pinia, powered by OpenWeatherMap",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:e2e",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "chart.js": "^4.6.1",
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "vue-router": "^5.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.1",
    "happy-dom": "^21.0.4",
    "jiti": "^2.7.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
